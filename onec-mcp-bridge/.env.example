ONEC_MCP_COMMAND=C:\tools\mcp-1c.exe
# Optional: enables the bridge-local full read-only source tool.
# ONEC_MCP_DUMP_PATH=C:\1C\DumpConfigToFiles
ONEC_MCP_ARGS=--base http://localhost:8080/hs/mcp-1c
ONEC_MCP_BRIDGE_TOKEN=change-this-token
ONEC_MCP_ALLOWED_TOOLS=get_metadata_tree,get_object_structure,get_form_structure,get_configuration_info,execute_query,validate_query
ONEC_MCP_INSPECTOR_TOKEN=change-this-to-a-different-token
ONEC_MCP_INSPECTOR_ALLOWED_TOOLS=get_metadata_tree,get_object_structure,get_form_structure,get_configuration_info,search_code,bsl_syntax_help,validate_query,read_source,read_method_source,get_edt_metadata_summary,list_module_methods,resolve_symbol,find_references,get_source_checksum,estimate_tool_payload,read_register_records
# ONEC_MCP_DIAGNOSTICS_TOKEN=change-this-to-a-third-token
ONEC_MCP_DIAGNOSTICS_ALLOWED_TOOLS=get_configuration_info,get_event_log
ONEC_MCP_REQUEST_TIMEOUT=60
ONEC_MCP_MAX_BODY_BYTES=1048576
ONEC_MCP_RATE_LIMIT_PER_MINUTE=120
