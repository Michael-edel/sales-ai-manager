ONEC_MCP_COMMAND=C:\tools\mcp-1c.exe
# Optional: enables the bridge-local full read-only source tool.
# ONEC_MCP_DUMP_PATH=C:\1C\DumpConfigToFiles
ONEC_MCP_ARGS=--base http://localhost:8080/hs/mcp-1c
ONEC_MCP_BRIDGE_TOKEN=change-this-token
ONEC_MCP_ALLOWED_TOOLS=get_metadata_tree,get_object_structure,get_form_structure,get_configuration_info,search_code,bsl_syntax_help,execute_query,validate_query,get_event_log,read_source
ONEC_MCP_REQUEST_TIMEOUT=60
